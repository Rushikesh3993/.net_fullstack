<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Main_clinic.master.cs" Inherits="Clinic_project.Main_clinic" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
        <style>
    html, body {
        height: 100%;
        margin: 0;
    }
    body {
        display: flex;
        flex-direction: column;
    }
    main {
        flex: 1; /* Makes main content take available space */
    }
</style>
    </asp:ContentPlaceHolder>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
</head>
<body>

    <!-- Add this inside your MasterPage or any .aspx page -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark py-4">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold fst-italic" href="Dashboard.aspx">ClinicSystem_Rushi</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false"
                aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link active mx-2" href="index_home.aspx">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link mx-2" href="PatientApp.aspx">Appointments</a>
                    </li>

                    <% if (Session["did"] == null && Session["admin"] == null)
                        { %>
                    <!-- Show doctor registration + login when no one is logged in -->
                    <li class="nav-item">
                        <a class="nav-link mx-2" href="DoctorReg.aspx">Doctor Registration</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link mx-2" href="DoctorLogin.aspx">Doctor Login</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link mx-2" href="AdminLogin.aspx">Admin Login</a>
                    </li>
                    <% } %>

                    <% if (Session["did"] != null)
                        { %>
                    <!-- If doctor logged in -->
                    <li class="nav-item">
                        <a class="nav-link mx-2" href="DoctorDashboard.aspx">My Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a href="Logout.aspx" class="btn btn-outline-danger mx-2">Log Out</a>
                    </li>
                    <% } %>

                    <% if (Session["admin"] != null)
                        { %>
                    <!-- If admin logged in -->
                   <!--  <li class="nav-item">
                        <a class="nav-link mx-2" href="AdminApproval.aspx">Admin Panel</a>
                    </li> -->
                    <li class="nav-item">
                        <a href="Logout.aspx" class="btn btn-outline-danger mx-2">Log Out</a>
                    </li>
                    <% } %>
                </ul>

            </div>
        </div>
    </nav>


    <div>
        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
        </asp:ContentPlaceHolder>
    </div>

 <!-- Sticky Footer -->
    <footer class="bg-dark text-white py-4 mt-auto">
        <div class="container text-center">
            <p class="mb-1">&copy; 2025 ClinicSystem_Rushi. All Rights Reserved.</p>
            <p class="mb-0">
                <a href="#" class="text-white me-3"><i class="bi bi-facebook"></i></a>
                <a href="#" class="text-white me-3"><i class="bi bi-twitter"></i></a>
                <a href="#" class="text-white me-3"><i class="bi bi-instagram"></i></a>
                <a href="#" class="text-white"><i class="bi bi-linkedin"></i></a>
            </p>
        </div>
    </footer>


</body>
</html>
