@model List<WebApplication2Code_first_approach_entity.Models.Students>
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Fetch Student</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">

    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(to right, #4facfe, #00f2fe);
            margin: 0;
            padding: 40px;
            color: #333;
        }

        h1 {
            text-align: center;
            color: white;
            margin-bottom: 30px;
            text-shadow: 1px 1px 2px #000;
        }

        table {
            border-collapse: collapse;
            width: 90%;
            margin: auto;
            background-color: white;
            box-shadow: 0 4px 20px rgba(0,0,0,0.2);
            border-radius: 10px;
            overflow: hidden;
        }

        th {
            background-color: #007bff;
            color: white;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding: 12px 15px;
            font-size: 15px;
        }

        td {
            text-align: center;
            padding: 10px;
            border-bottom: 1px solid #ddd;
        }

        tr:nth-child(even) {
            background-color: #f8f9fa;
        }

        tr:hover {
            background-color: #e9f5ff;
            transform: scale(1.01);
            transition: all 0.2s ease-in-out;
        }

        .container {
            max-width: 1100px;
            margin: auto;
            background: rgba(255,255,255,0.1);
            padding: 20px;
            border-radius: 15px;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>📋 Student Records</h1>

        <table>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Gender</th>
                <th>DOB</th>
                <th>Course</th>
                <th>Address</th>
                <th>Action</th>
            </tr>

            @foreach (var x in Model)
            {
                <tr>
                    <td>@x.sid</td>
                    <td>@x.sname</td>
                    <td>@x.semail</td>
                    <td>@x.sphone</td>
                    <td>@x.sgender</td>
                    <td>@x.sdob</td>
                    <td>@x.scourse</td>
                    <td>@x.saddress</td>
                    <td>
                        <a href="/Student/EditStudent/@x.sid" class="btn btn-outline-primary">Edit</a>
                        <a href="/Student/DelStudent/@x.sid" class="btn btn-outline-primary">Delete</a>
                    </td>
                </tr>
            }
        </table>
    </div>
</body>
</html>
