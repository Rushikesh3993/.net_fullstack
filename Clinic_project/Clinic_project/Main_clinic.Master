</head>
<body>

    <!-- Add this inside your MasterPage or any .aspx page -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark py-4">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold fst-italic" href="Dashboard.aspx">ClinicSystem_Rushi</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false"
                aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link active mx-2" aria-current="page" href="index_home.aspx">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link mx-2" href="">Our Doctors</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link mx-2" href="PatientApp.aspx">Appointments</a>
                    </li>
                    <li>
                        <a class="nav-link mx-2" href="DoctorReg.aspx">Doctor Registration</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link mx-2" href="">Contact Us</a>
                    </li>
                    <li class="nav-item">
                        <button type="button" class="btn btn-outline-danger mx-2">Log Out</button>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div>
        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
        </asp:ContentPlaceHolder>
    </div>

</body>
