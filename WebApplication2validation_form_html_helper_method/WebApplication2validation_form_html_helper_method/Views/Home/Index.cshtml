
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Index</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">

    <style>
        body{
            height:100vh;
            display:flex;
            justify-content:center;
            align-items:center;
        }
        .t {
            width:390px;
            height:400px;
            border-style: groove;
            text-align: center;
            align-content: center;
        }
    </style>
</head>
<body>
    <div class="t">
        <h1>Registration Form</h1>

        @using (Html.BeginForm("Index", "Home", FormMethod.Post))
        {
            <div class="mb-3">
                @Html.Label("Enter Username:")
                @Html.TextBox("t1", "", new { @class = "form-control" })
                @Html.ValidationMessage("t1", "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.Label("Enter Email:")
                @Html.TextBox("t2", "", new { @class = "form-control" })
                @Html.ValidationMessage("t2", "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.Label("Enter Password:")
                @Html.Password("t3", "", new { @class = "form-control" })  <!-- ✅ Use Password() -->
                @Html.ValidationMessage("t3", "", new { @class = "text-danger" })
            </div>

            <button type="submit" class="btn btn-primary ">Register</button><br />

            @ViewBag.sus;
        }
    </div>

</body>
</html>
